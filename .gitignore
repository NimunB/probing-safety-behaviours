# Activation cache — large (GBs), recomputable, and CONTENT-BLIND (keyed on dataset name +
# example count, not content). Never commit: a stale cache that looks valid is worse than none.
activation_cache/

# Fallback clone of ApolloResearch/deception-detection (535 MB). Only appears if the vendored
# files under data/ are missing — data/ is the intended source. See data/PROVENANCE.md.
deception-detection/

# Secrets: HF_TOKEN (gated Llama repo) and ANTHROPIC_API_KEY (judge).
.env
*.env

# Agent transcripts. Never commit: an IDE-selection block can paste .env contents verbatim
# into a transcript, which is how both live keys leaked in the pre-rewrite history.
docs-for-nimun/claude-conversations/

# --- NOT ignored, deliberately -----------------------------------------------------------
# data/            ~500 KB of vendored Apollo files; frozen inputs, must be versioned.
# exported_probes/ ~0.5 MB per behaviour; the only GPU-expensive artefact that is not
#                  reproducible from the repo alone. Commit these.

# LaTeX build artifacts (research-report/report.tex); the PDF is regenerable via latexmk.
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
*.toc
research-report/*.pdf
# ...except the dissertation itself, which is committed so it is readable on GitHub.
!research-report/Nimun_Bajwa_PG_Project_Dissertation.pdf

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.pytest_cache/
