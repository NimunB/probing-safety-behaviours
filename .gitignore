# Activation cache — large (GBs), recomputable, and CONTENT-BLIND (keyed on dataset name +
# example count, not content). Never commit: a stale cache that looks valid is worse than none.
activation_cache/

# Fallback clone of ApolloResearch/deception-detection (535 MB). Only appears if the vendored
# files under data/ are missing — data/ is the intended source. See data/PROVENANCE.md.
deception-detection/

# Secrets: HF_TOKEN (gated Llama repo) and ANTHROPIC_API_KEY (judge).
.env
*.env

# Working notes, decision records, source-paper PDFs, and agent transcripts — local only.
# The transcripts in particular must never be committed: an IDE-selection block can paste .env
# contents verbatim into a transcript, which is how both live keys leaked in the pre-rewrite
# history. Nothing in here is needed to run the notebooks (utils.py is the superseded ARENA
# helper; its needed functions are vendored into safety_probes/chat.py and viz.py).
docs-for-nimun/

# --- NOT ignored, deliberately -----------------------------------------------------------
# data/            ~500 KB of vendored Apollo files; frozen inputs, must be versioned.
# exported_probes/ ~0.5 MB per behaviour; the only GPU-expensive artefact that is not
#                  reproducible from the repo alone. Commit these.

# LaTeX build artifacts; the PDF is regenerable via latexmk.
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
*.toc

# The dissertation and its sources — local only (untracked 2026-08-25).
# Previously committed; the last committed version is recoverable from git history
# at a43b4c8 (`git show a43b4c8:research-report/<file>`).
research-report/

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.pytest_cache/

# presentation working files (local only)
presentation-assets/
presentation-plan.md
